{
  "name": "d3b-skullstrip-normalize",
  "label": "Skull-strip & normalize images",
  "description": "Apply brain mask & normalize skull-stripped images",
  "author": "D3b-TIRU",
  "maintainer": "D3b-TIRU <flywheel@d3b.center>",
  "url": "https://github.com/d3b-center/fw-skullstrip-normalize", 
  "source": "https://github.com/d3b-center/fw-skullstrip-normalize", 
  "version": "0.0.1",
  "license": "Apache-2.0",
  "custom": {
    "flywheel": {
      "suite": "D3b-TIRU"
    },
    "gear-builder": {
      "category": "utility",
      "image": "chop.flywheel.io/d3b-skullstrip-normalize:0.0.1"
    }
  },
  "inputs": {
    "input-file": {
      "base": "file",
      "description": "Input image.",
      "optional": false
    },
    "brain-mask": {
      "base": "file",
      "description": "Binary brain mask.",
      "optional": false
    },
    "api-key": {
      "base": "api-key",
      "read-only": false
    }
  },
  "config": {
    "debug": {
      "default": false,
      "description": "Log debug messages",
      "type": "boolean"
    }
  },
  "environment": {
    "PATH": "/opt/poetry/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "PYTHON_VERSION": "3.9.7",
    "PIP_NO_CACHE_DIR": "0",
    "POETRY_HOME": "/opt/poetry",
    "POETRY_VERSION": "1.1.11",
    "POETRY_VIRTUALENVS_CREATE": "false",
    "FLYWHEEL": "/flywheel/v0"
  },
  "command": "python run.py"
}